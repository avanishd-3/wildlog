{
  "name": "@wildlog/reverse-proxy",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/http-proxy": "^11.4.1",
    "dotenv": "catalog:",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildlog/config": "workspace:*",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}